# Dependencies
node_modules/

# Build output
dist/
coverage/

# Session data (user-generated)
output/sessions/*/
output/bugs/*.md
!output/sessions/INDEX.md
!output/bugs/all-bugs.md

# Auth & secrets
# `.auth/*.json` alone is not enough: /qa-verify-backend's API lane uses PERSISTENT
# BROWSER PROFILE DIRECTORIES (`.auth/<profile>/`), which hold live session cookies
# for a real account. Ignore everything under .auth/ and keep the placeholder.
.auth/*
!.auth/.gitkeep
.env

# Playwright
.playwright-cli/

# Traces & recordings
*.trace.zip
*.webm

# OS
.DS_Store

# Local target configs and gathered ticket context.
# These hold internal hostnames, account ids and ticket content — keep them local.
# Name a private target `local-*.yml` (or add your own prefix here) and it stays
# out of version control.
data/targets/local-*.yml
output/context/*.md
!output/context/.gitkeep

# Project-local config (consumer projects; kept out of this repo too)
qa/.env
qa/bin/
output/metrics.jsonl
